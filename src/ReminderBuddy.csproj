<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>../assets/ReminderBuddy.ico</ApplicationIcon>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">../app.manifest</ApplicationManifest>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION').Trim())</Version>
    <AssemblyName>ReminderBuddy</AssemblyName>
    <Product>Reminder Buddy</Product>
    <Company>sidharth</Company>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <AvaloniaResource Include="../assets/ReminderBuddy.ico" Link="Assets/ReminderBuddy.ico" />
  </ItemGroup>
</Project>
